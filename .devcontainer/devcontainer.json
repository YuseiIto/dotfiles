{
  "name": "yuseiito-dev (devcontainer)",
  "image": "ghcr.io/yuseiito/yuseiito-dev:devcontainer-latest",
  "features": {
    "ghcr.io/yuseiito/dotfiles/agent-sandbox:1": {
      "allowClaudeAiConnectors": true
    }
  },
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "remoteEnv": {
    "DOTFILES_ROLE": "devcontainer",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "mounts": [
    "source=dotfiles-zsh-history,target=/home/ubuntu/.local/share/zsh,type=volume"
  ],
  // The git helper reads GH_TOKEN on each use, so creation succeeds without a
  // token. --file keeps git config --global from writing through the
  // symlinked ~/.config/git into the image's dotfiles copy.
  "postCreateCommand": {
    "claude-dotfiles": "/home/ubuntu/.local/bin/claude-dotfiles-link",
    "git-credentials": "git config --file /home/ubuntu/.gitconfig credential.https://github.com.helper '!gh auth git-credential'"
  },
  "waitFor": "postStartCommand",
  "hostRequirements": {
    "gpu": "optional"
  },
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {}
    }
  }
}
