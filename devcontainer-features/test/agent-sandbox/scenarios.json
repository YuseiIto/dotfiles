{
  "default": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "agent-sandbox": {}
    }
  },
  "restrict_sudo_preexisting": {
    "build": {
      "dockerfile": "Dockerfile"
    },
    "remoteUser": "ubuntu",
    "features": {
      "agent-sandbox": {}
    }
  },
  "restrict_sudo_false": {
    "build": {
      "dockerfile": "Dockerfile"
    },
    "remoteUser": "ubuntu",
    "features": {
      "agent-sandbox": {
        "restrictSudo": false
      }
    }
  }
}
