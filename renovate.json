{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff"
  ],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mitamae version in bin/setup",
      "managerFilePatterns": ["/^mitamae/bin/setup$/"],
      "matchStrings": ["mitamae_version=\"(?<currentValue>.*?)\""],
      "depNameTemplate": "itamae-kitchen/mitamae",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update versions and '<tag>@<sha256>' release asset digests annotated with a `# renovate:` comment in mitamae cookbooks",
      "managerFilePatterns": ["/^mitamae/cookbooks/.+\\.rb$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+ = '(?<currentValue>[^'@]+)'",
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\s+[^'\\n]*'(?<currentValue>[^'@]+)@(?<currentDigest>[0-9a-f]{64})'"
      ]
    },
    {
      "customType": "regex",
      "description": "Update Alacritty DMG tag and digest in cookbooks/alacritty/default.rb",
      "managerFilePatterns": ["/^mitamae/cookbooks/alacritty/default.rb$/"],
      "matchStrings": [
        "alacritty_tag = '(?<currentValue>[^']+)'\\s+alacritty_dmg_sha256 = '(?<currentDigest>[0-9a-f]{64})'"
      ],
      "depNameTemplate": "alacritty/alacritty",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "packageRules": [
    {
      "description": "Bump a cookbook's version pin and its asset digests in one PR, since a version without matching digests fails to install",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["mitamae/cookbooks/**"],
      "groupName": "{{{depName}}}"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Group devcontainer feature updates",
      "matchManagers": ["devcontainer"],
      "groupName": "devcontainer-features",
      "automerge": true
    },
    {
      "description": "Group Docker base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images"
    },
    {
      "description": "Group bundler (Gemfile) updates",
      "matchManagers": ["bundler"],
      "groupName": "bundler"
    }
  ]
}
